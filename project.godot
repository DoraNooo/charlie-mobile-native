; Engine configuration file.
; CHARLIE — De l'atome au cosmos (Godot 4 Native Mobile Project)

config_version=5

[application]

config/name="CHARLIE — De l'atome au cosmos"
config/description="Guide la petite Charlie, une goutte de lave aux deux petites dents, de l'atome jusqu'aux galaxies."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.0352941, 0.0509804, 0.117647, 1)
boot_splash/image="res://assets/art/boot-splash.png"
boot_splash/fullsize=true
boot_splash/show_image=true
config/icon="res://assets/icons/icon-512.png"

[autoload]

Scales="*res://scripts/scales.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_2d=2
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.027, 0.078, 0.11, 1)
